              "type": "string"
            }
          },
          "statuses": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "PENDING",
                "SUCCESS",
                "FAILED",
                "VOIDED",
                "REVERSED"
              ]
            }
          },
          "channel_categories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reference_id": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "created_gte": {
            "type": "string",
            "description": "ISO 8601"
          },
          "created_lte": {
            "type": "string",
            "description": "ISO 8601"
          },
          "cursor": {
            "type": "string",
            "description": "next_cursor from the previous call, to get the next page"
          },
          "limit": {
            "type": "integer",
            "description": "Maximum items per page (sent as `limit`)",
            "minimum": 1,
            "maximum": 50
          }
        },
        "required": []
      }
    },
    {
      "name": "get_refund",
      "description": "Retrieve a refund",
      "parameters": {
        "type": "object",
