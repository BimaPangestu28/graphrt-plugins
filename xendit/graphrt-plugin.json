      "description": "Account balance (CASH by default)",
      "parameters": {
        "type": "object",
        "properties": {
          "account_type": {
            "type": "string",
            "enum": [
              "CASH",
              "HOLDING"
            ]
          },
          "currency": {
            "type": "string",
            "description": "For multi-currency accounts"
          },
          "at_timestamp": {
            "type": "string",
            "description": "Balance at this time (ISO 8601)"
          }
        },
        "required": []
      }
    },
    {
      "name": "list_transactions",
      "description": "List money movements (payments, refunds, payouts, fees), newest first",
      "parameters": {
        "type": "object",
        "properties": {
          "types": {
            "type": "array",
            "description": "e.g. PAYMENT, REFUND, DISBURSEMENT",
