          }
        },
        "required": [
          "coin_id",
          "vs_currency",
          "days"
        ]
      },
      "outputs": [
        {
          "name": "data",
          "type": "any",
          "description": "API result"
        },
        {
          "name": "next_cursor",
          "type": "string",
          "description": "Cursor for the next page, empty when there is none"
        }
      ]
    },
    {
      "kind": "coingecko.search",
      "title": "Search coins",
      "description": "Find coins, exchanges, categories and NFTs by name or symbol; coins[] has id, name, symbol, market_cap_rank",
      "category": "integration",
      "config_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Name or symbol, e.g. pepe",
            "minLength": 1
          },
          "access_token": {
            "type": "string",
            "description": "Overrides the plugin's default token for this node (use a secret; needs --trust-plugin)"
          }
        },
        "required": [
          "query"
        ]
      },
      "outputs": [
        {
          "name": "data",
          "type": "any",
          "description": "API result"
        },
        {
          "name": "next_cursor",
          "type": "string",
          "description": "Cursor for the next page, empty when there is none"
        }
      ]
    },
    {
