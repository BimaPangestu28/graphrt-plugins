    {
      "kind": "coingecko.api_request",
      "title": "CoinGecko API request",
      "description": "Call any CoinGecko API endpoint that has no dedicated operation, e.g. path \"/coins/bitcoin/tickers\". Only the API's own host is allowed.",
      "category": "integration",
      "config_schema": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string",
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE"
            ],
            "default": "GET"
          },
          "path": {
            "type": "string",
            "description": "Path relative to the API base, starting with \"/\", e.g. \"/coins/bitcoin/tickers\""
          },
          "query": {
            "type": "object",
            "description": "Query parameters"
          },
          "body": {
            "type": "object",
            "description": "JSON body for POST/PUT/PATCH"
          },
          "access_token": {
            "type": "string",
            "description": "Overrides the plugin's default token for this node (use a secret; needs --trust-plugin)"
          }
        },
        "required": [
          "path"
        ]
      },
      "outputs": [
        {
          "name": "data",
          "type": "any",
          "description": "API result"
        },
        {
          "name": "next_cursor",
          "type": "string",
          "description": "Cursor for the next page, empty when there is none"
        }
      ]
    }
  ],
  "tools": [
    {
      "name": "get_simple_price",
      "description": "Current prices of coins in one or more currencies: {coin_id: {usd: 62673, usd_24h_change: ...}}",
      "parameters": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
