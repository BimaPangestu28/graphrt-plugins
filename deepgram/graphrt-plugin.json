            "type": "boolean",
            "description": "Mask profanity"
          },
          "filler_words": {
            "type": "boolean",
            "description": "Keep filler words such as uh and um"
          },
          "multichannel": {
            "type": "boolean",
            "description": "Transcribe each audio channel separately"
          },
          "tag": {
            "type": "array",
            "description": "Tags for usage reports",
            "maxItems": 10,
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "file"
        ]
      }
    },
    {
      "name": "text_to_speech",
      "description": "Turn text (up to 2000 characters) into speech with an Aura voice and save the audio file in DEEPGRAM_OUTPUT_DIR (billed per character)",
      "parameters": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "Text to speak (max 2000 characters)",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "description": "Aura voice model, e.g. aura-2-thalia-en, aura-2-andromeda-en (see list_models tts)",
            "default": "aura-2-thalia-en"
          },
          "encoding": {
            "type": "string",
            "description": "Audio encoding (default mp3)",
            "enum": [
              "linear16",
              "flac",
              "mulaw",
              "alaw",
              "mp3",
              "opus",
              "aac"
            ]
          },
          "container": {
            "type": "string",
            "description": "Container: wav for linear16/mulaw/alaw, ogg for opus",
            "enum": [
              "none",
              "wav",
              "ogg"
            ]
          },
          "sample_rate": {
            "type": "integer",
            "description": "Sample rate in Hz, e.g. 24000 (depends on the encoding)"
          },
          "bit_rate": {
            "type": "integer",
            "description": "Bit rate in bps, e.g. 48000 (mp3: 32000 or 48000)"
          }
        },
        "required": [
          "text"
        ]
      }
    },
    {
      "name": "analyze_text",
      "description": "Summarize text and detect topics, intents and sentiment (exactly one of text or url; billed per token)",
      "parameters": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "Text to analyze (or url)",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "description": "URL of a text file to analyze (or text)",
            "minLength": 1
          },
          "language": {
            "type": "string",
            "description": "Language of the text (intelligence features support en)",
            "default": "en"
          },
          "summarize": {
            "type": "boolean",
            "description": "Add a summary"
          },
          "topics": {
            "type": "boolean",
            "description": "Detect topics"
          },
          "intents": {
            "type": "boolean",
            "description": "Detect intents"
          },
          "sentiment": {
            "type": "boolean",
            "description": "Sentiment per segment and on average"
          }
        },
        "required": []
      }
    },
    {
      "name": "list_models",
      "description": "List the speech-to-text (stt) and text-to-speech (tts) models with languages and versions",
      "parameters": {
        "type": "object",
        "properties": {
          "include_outdated": {
            "type": "boolean",
            "description": "Also list outdated model versions"
          }
        },
        "required": []
      }
    },
    {
      "name": "get_model",
      "description": "Get one model by its uuid",
      "parameters": {
        "type": "object",
        "properties": {
          "model_id": {
            "type": "string",
            "description": "Model uuid from list_models"
          }
        },
        "required": [
          "model_id"
        ]
      }
    },
    {
      "name": "list_projects",
      "description": "List the projects the key can access (project_id and name)",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": []
      }
    },
    {
      "name": "get_project_balances",
      "description": "Remaining credit balances of a project",
      "parameters": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string",
            "description": "Project id from list_projects"
          }
        },
        "required": [
          "project_id"
        ]
      }
    },
    {
      "name": "list_project_requests",
      "description": "List a project's API requests (newest first) with endpoint, status and response summary",
      "parameters": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string",
            "description": "Project id from list_projects"
          },
          "start": {
            "type": "string",
            "description": "From this date or time (YYYY-MM-DD or ISO 8601)"
          },
          "end": {
            "type": "string",
            "description": "Until this date or time (YYYY-MM-DD or ISO 8601)"
          },
          "endpoint": {
            "type": "string",
            "description": "Only this endpoint",
            "enum": [
              "listen",
              "read",
              "speak",
              "agent"
            ]
          },
          "method": {
            "type": "string",
            "description": "Only this request method",
            "enum": [
              "sync",
              "async",
              "streaming"
            ]
          },
          "status": {
            "type": "string",
            "description": "Only this status",
            "enum": [
              "succeeded",
              "failed"
            ]
          },
          "request_id": {
            "type": "string",
            "description": "Only this request id"
          },
          "cursor": {
            "type": "string",
            "description": "next_cursor from the previous call, to get the next page"
          },
          "limit": {
            "type": "integer",
            "description": "Maximum items per page (sent as `limit`)",
            "minimum": 1,
            "maximum": 1000
          }
        },
        "required": [
          "project_id"
        ]
      }
    },
    {
      "name": "api_request",
      "description": "Call any Deepgram API endpoint that has no dedicated operation, e.g. path \"/v1/projects\". Only the API's own host is allowed.",
      "parameters": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string",
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE"
            ],
            "default": "GET"
          },
          "path": {
            "type": "string",
            "description": "Path relative to the API base, starting with \"/\", e.g. \"/v1/projects\""
          },
          "query": {
            "type": "object",
            "description": "Query parameters"
          },
          "body": {
            "type": "object",
            "description": "JSON body for POST/PUT/PATCH"
          }
        },
        "required": [
          "path"
        ]
      }
    }
  ]
}
