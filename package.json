{
  "name": "graphrt-plugins",
  "version": "0.1.0",
  "private": true,
  "description": "Plugins for graphrt",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "sync": "node scripts/sync-shared.mjs && node scripts/sync-plugin-status.mjs",
    "check": "node scripts/sync-shared.mjs --check && node scripts/sync-plugin-status.mjs --check",
    "test": "node scripts/run-tests.mjs",
    "pack:plugins": "node scripts/pack-plugins.mjs",
    "verify:plugins": "node scripts/verify-plugins.mjs",
    "publish:plugins": "node scripts/publish-plugins.mjs",
    "ci:local": "scripts/ci-local.sh"
  }
}
