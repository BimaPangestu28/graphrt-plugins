{
  "name": "microsoft-teams",
  "version": "0.1.0",
  "description": "Microsoft Teams via Microsoft Graph: teams, channels, channel messages and replies, chats; agent sends need an opt-in",
  "license": "Apache-2.0",
  "runtime": "process",
  "command": "node",
  "args": [
    "plugin.mjs"
  ],
  "permissions": {
    "network": true,
    "secrets": true,
    "env": [
      "MICROSOFT_CLIENT_SECRET",
      "MICROSOFT_CLIENT_ID",
      "MICROSOFT_REFRESH_TOKEN",
      "MICROSOFT_TENANT_ID",
      "MICROSOFT_TEAMS_TOOL_ALLOW_SEND"
    ]
  },
  "limits": {
    "timeout_ms": 120000,
    "max_concurrency": 8
  },
  "nodes": [
    {
      "kind": "microsoft-teams.get_me",
      "title": "Signed-in user",
      "description": "The signed-in user (who the refresh token belongs to)",
      "category": "integration",
      "config_schema": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "description": "Overrides the plugin's default token for this node (use a secret; needs --trust-plugin)"
          }
        },
        "required": []
      },
      "outputs": [
        {
          "name": "data",
          "type": "any",
          "description": "API result"
        },
        {
          "name": "next_cursor",
          "type": "string",
          "description": "Cursor for the next page, empty when there is none"
        }
      ]
    },
    {
