      "kind": "microsoft-teams.send_channel_message",
      "title": "Post to channel",
      "description": "Post a new message in a channel (as an agent tool only when MICROSOFT_TEAMS_TOOL_ALLOW_SEND=1)",
      "category": "integration",
      "config_schema": {
        "type": "object",
        "properties": {
          "team_id": {
            "type": "string",
            "description": "Team id (the Microsoft 365 group id)"
          },
          "channel_id": {
            "type": "string",
            "description": "Channel id, e.g. 19:abc...@thread.tacv2"
          },
          "content": {
            "type": "string",
            "description": "Message text, or HTML when content_type is html",
            "minLength": 1
          },
          "content_type": {
            "type": "string",
            "enum": [
              "text",
              "html"
            ],
            "default": "text"
          },
          "subject": {
            "type": "string",
