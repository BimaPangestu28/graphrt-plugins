      "config_schema": {
        "type": "object",
        "properties": {
          "team_id": {
            "type": "string",
            "description": "Team id (the Microsoft 365 group id)"
          },
          "channel_id": {
            "type": "string",
            "description": "Channel id, e.g. 19:abc...@thread.tacv2"
          },
          "expand_replies": {
            "type": "string",
            "description": "replies: include up to 1000 replies per message",
            "enum": [
              "replies"
            ]
          },
