{
  "name": "hubspot",
  "version": "0.1.0",
  "description": "HubSpot CRM (API 2026-09): contacts, companies, deals, tickets and other objects (list, get, search, create, update), associations, notes, properties, pipelines, owners; archiving is node only",
  "license": "Apache-2.0",
  "runtime": "process",
  "command": "node",
  "args": [
    "plugin.mjs"
  ],
  "permissions": {
    "network": true,
    "secrets": true,
    "env": [
      "HUBSPOT_ACCESS_TOKEN"
    ]
  },
  "limits": {
    "timeout_ms": 120000,
    "max_concurrency": 8
  },
  "nodes": [
    {
      "kind": "hubspot.list_objects",
      "title": "List records",
      "description": "A page of records of one object type (oldest first); use search_objects to filter or sort",
      "category": "integration",
      "config_schema": {
        "type": "object",
        "properties": {
          "object_type": {
            "type": "string",
            "description": "CRM object type",
            "enum": [
              "contacts",
              "companies",
              "deals",
              "tickets",
              "notes",
              "tasks",
              "calls",
              "meetings",
              "emails",
              "products",
              "line_items",
              "quotes",
              "leads"
            ]
          },
          "properties": {
            "type": "array",
            "description": "Properties to return, e.g. [email, firstname, lastname] (default: a few basic ones)",
            "maxItems": 200,
            "items": {
              "type": "string"
            }
          },
          "associations": {
            "type": "array",
            "description": "Object types to return associated record ids for, e.g. [companies, deals]",
            "maxItems": 20,
            "items": {
              "type": "string"
            }
          },
          "archived": {
            "type": "boolean",
            "description": "Only archived (recycle bin) records"
          },
          "cursor": {
            "type": "string",
            "description": "next_cursor from the previous call, to get the next page"
          },
          "limit": {
            "type": "integer",
            "description": "Maximum items per page (sent as `limit`)",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          },
          "access_token": {
            "type": "string",
            "description": "Overrides the plugin's default token for this node (use a secret; needs --trust-plugin)"
          }
        },
        "required": [
          "object_type"
        ]
      },
      "outputs": [
        {
          "name": "data",
          "type": "any",
          "description": "API result"
        },
        {
          "name": "next_cursor",
          "type": "string",
          "description": "Cursor for the next page, empty when there is none"
        }
      ]
    },
    {
      "kind": "hubspot.get_object",
      "title": "Get record",
      "description": "One record by id, or by a unique property such as email (id_property)",
      "category": "integration",
      "config_schema": {
        "type": "object",
        "properties": {
          "object_type": {
            "type": "string",
            "description": "CRM object type",
            "enum": [
              "contacts",
              "companies",
              "deals",
              "tickets",
              "notes",
              "tasks",
              "calls",
              "meetings",
              "emails",
              "products",
              "line_items",
              "quotes",
              "leads"
            ]
          },
          "object_id": {
            "type": "string",
            "description": "Record id (hs_object_id), or a unique property value with id_property"
          },
          "properties": {
            "type": "array",
            "description": "Properties to return, e.g. [email, firstname, lastname] (default: a few basic ones)",
            "maxItems": 200,
            "items": {
              "type": "string"
            }
          },
          "properties_with_history": {
            "type": "array",
            "description": "Properties to return with their previous values",
            "maxItems": 200,
            "items": {
              "type": "string"
            }
          },
          "associations": {
            "type": "array",
            "description": "Object types to return associated record ids for, e.g. [companies, deals]",
            "maxItems": 20,
            "items": {
              "type": "string"
            }
          },
          "id_property": {
            "type": "string",
            "description": "Unique property that object_id holds instead of the record id, e.g. email"
          },
          "archived": {
            "type": "boolean"
          },
          "access_token": {
            "type": "string",
            "description": "Overrides the plugin's default token for this node (use a secret; needs --trust-plugin)"
          }
        },
        "required": [
          "object_type",
          "object_id"
        ]
      },
      "outputs": [
        {
          "name": "data",
          "type": "any",
          "description": "API result"
        },
        {
          "name": "next_cursor",
          "type": "string",
          "description": "Cursor for the next page, empty when there is none"
        }
      ]
    },
    {
      "kind": "hubspot.search_objects",
      "title": "Search records",
      "description": "Search records with filters (AND within a group, OR across up to 5 groups), a text query and one sort; at most 10,000 results per search",
      "category": "integration",
      "config_schema": {
        "type": "object",
        "properties": {
          "object_type": {
            "type": "string",
            "description": "CRM object type",
            "enum": [
              "contacts",
              "companies",
              "deals",
              "tickets",
              "notes",
              "tasks",
              "calls",
              "meetings",
              "emails",
              "products",
              "line_items",
              "quotes",
              "leads"
            ]
          },
          "query": {
            "type": "string",
            "description": "Text matched against the default searchable properties (e.g. name, email, domain)"
          },
          "filter_groups": {
            "type": "array",
            "description": "e.g. [{\"filters\": [{\"propertyName\": \"lifecyclestage\", \"operator\": \"EQ\", \"value\": \"lead\"}]}]; operators EQ, NEQ, LT, LTE, GT, GTE, BETWEEN, IN, NOT_IN, HAS_PROPERTY, NOT_HAS_PROPERTY, CONTAINS_TOKEN, NOT_CONTAINS_TOKEN",
            "maxItems": 5,
            "items": {
              "type": "object"
            }
          },
          "sorts": {
            "type": "array",
            "description": "One sort, e.g. [{\"propertyName\": \"createdate\", \"direction\": \"DESCENDING\"}]",
            "maxItems": 1,
            "items": {
              "type": "object"
            }
          },
          "properties": {
            "type": "array",
            "description": "Properties to return",
            "maxItems": 200,
            "items": {
              "type": "string"
            }
          },
          "cursor": {
            "type": "string",
            "description": "next_cursor from the previous call, to get the next page"
          },
          "limit": {
            "type": "integer",
            "description": "Maximum items per page (sent as `limit`)",
            "minimum": 1,
            "maximum": 200,
            "default": 20
          },
          "access_token": {
            "type": "string",
            "description": "Overrides the plugin's default token for this node (use a secret; needs --trust-plugin)"
          }
        },
        "required": [
          "object_type"
        ]
      },
      "outputs": [
        {
          "name": "data",
          "type": "any",
          "description": "API result"
        },
        {
          "name": "next_cursor",
          "type": "string",
          "description": "Cursor for the next page, empty when there is none"
        }
      ]
    },
    {
      "kind": "hubspot.create_object",
      "title": "Create record",
      "description": "Create a record with property values, optionally associated with other records",
      "category": "integration",
      "config_schema": {
        "type": "object",
        "properties": {
          "object_type": {
            "type": "string",
            "description": "CRM object type",
            "enum": [
              "contacts",
              "companies",
              "deals",
              "tickets",
              "notes",
              "tasks",
              "calls",
              "meetings",
              "emails",
              "products",
              "line_items",
              "quotes",
              "leads"
            ]
          },
          "properties": {
            "type": "object",
            "description": "Property values by internal name, e.g. {\"email\": \"ada@example.com\", \"firstname\": \"Ada\"}"
          },
          "associations": {
            "type": "array",
            "description": "e.g. [{\"to\": {\"id\": \"123\"}, \"types\": [{\"associationCategory\": \"HUBSPOT_DEFINED\", \"associationTypeId\": 279}]}]",
            "maxItems": 100,
            "items": {
              "type": "object"
            }
          },
          "access_token": {
            "type": "string",
            "description": "Overrides the plugin's default token for this node (use a secret; needs --trust-plugin)"
          }
        },
        "required": [
          "object_type",
          "properties"
        ]
      },
      "outputs": [
        {
          "name": "data",
          "type": "any",
          "description": "API result"
        },
        {
          "name": "next_cursor",
          "type": "string",
          "description": "Cursor for the next page, empty when there is none"
        }
      ]
    },
