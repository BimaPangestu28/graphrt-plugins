    {
      "kind": "hubspot.api_request",
      "title": "HubSpot API request",
      "description": "Call any HubSpot API endpoint that has no dedicated operation, e.g. path \"/crm/objects/2026-09/contacts/<id>/associations/deals\". Only the API's own host is allowed. Agent tools may only read paths under /crm/objects, /crm/properties, /crm/pipelines, /crm/owners, /crm/associations, /crm/v3/objects, /crm/v3/properties, /crm/v3/pipelines, /crm/v3/owners, /crm/v4/objects, /crm/v4/associations, /account-info/2026-09/details, /account-info/v3/details.",
      "category": "integration",
      "config_schema": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string",
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE"
            ],
            "default": "GET"
          },
          "path": {
            "type": "string",
            "description": "Path relative to the API base, starting with \"/\", e.g. \"/crm/objects/2026-09/contacts/<id>/associations/deals\""
          },
          "query": {
            "type": "object",
            "description": "Query parameters"
          },
          "body": {
            "type": "object",
            "description": "JSON body for POST/PUT/PATCH"
          },
          "access_token": {
            "type": "string",
            "description": "Overrides the plugin's default token for this node (use a secret; needs --trust-plugin)"
          }
        },
        "required": [
          "path"
        ]
      },
      "outputs": [
        {
          "name": "data",
          "type": "any",
          "description": "API result"
        },
        {
          "name": "next_cursor",
          "type": "string",
          "description": "Cursor for the next page, empty when there is none"
        }
      ]
    }
  ],
  "tools": [
    {
      "name": "list_objects",
      "description": "A page of records of one object type (oldest first); use search_objects to filter or sort",
      "parameters": {
        "type": "object",
        "properties": {
          "object_type": {
            "type": "string",
            "description": "CRM object type",
            "enum": [
              "contacts",
              "companies",
              "deals",
              "tickets",
              "notes",
              "tasks",
              "calls",
              "meetings",
              "emails",
              "products",
              "line_items",
              "quotes",
              "leads"
            ]
          },
          "properties": {
            "type": "array",
            "description": "Properties to return, e.g. [email, firstname, lastname] (default: a few basic ones)",
            "maxItems": 200,
            "items": {
              "type": "string"
            }
          },
          "associations": {
            "type": "array",
            "description": "Object types to return associated record ids for, e.g. [companies, deals]",
            "maxItems": 20,
            "items": {
              "type": "string"
            }
          },
          "archived": {
            "type": "boolean",
            "description": "Only archived (recycle bin) records"
          },
          "cursor": {
            "type": "string",
            "description": "next_cursor from the previous call, to get the next page"
          },
          "limit": {
            "type": "integer",
            "description": "Maximum items per page (sent as `limit`)",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          }
        },
        "required": [
          "object_type"
        ]
      }
    },
    {
      "name": "get_object",
      "description": "One record by id, or by a unique property such as email (id_property)",
      "parameters": {
        "type": "object",
        "properties": {
          "object_type": {
            "type": "string",
            "description": "CRM object type",
            "enum": [
              "contacts",
              "companies",
              "deals",
              "tickets",
              "notes",
              "tasks",
              "calls",
              "meetings",
              "emails",
              "products",
              "line_items",
              "quotes",
              "leads"
            ]
          },
          "object_id": {
            "type": "string",
            "description": "Record id (hs_object_id), or a unique property value with id_property"
          },
          "properties": {
            "type": "array",
            "description": "Properties to return, e.g. [email, firstname, lastname] (default: a few basic ones)",
            "maxItems": 200,
            "items": {
              "type": "string"
            }
          },
          "properties_with_history": {
            "type": "array",
            "description": "Properties to return with their previous values",
            "maxItems": 200,
            "items": {
              "type": "string"
            }
          },
          "associations": {
            "type": "array",
            "description": "Object types to return associated record ids for, e.g. [companies, deals]",
            "maxItems": 20,
            "items": {
              "type": "string"
            }
          },
          "id_property": {
            "type": "string",
            "description": "Unique property that object_id holds instead of the record id, e.g. email"
          },
          "archived": {
            "type": "boolean"
          }
        },
        "required": [
          "object_type",
          "object_id"
        ]
      }
    },
    {
      "name": "search_objects",
      "description": "Search records with filters (AND within a group, OR across up to 5 groups), a text query and one sort; at most 10,000 results per search",
      "parameters": {
        "type": "object",
        "properties": {
          "object_type": {
            "type": "string",
            "description": "CRM object type",
            "enum": [
              "contacts",
              "companies",
              "deals",
              "tickets",
              "notes",
              "tasks",
              "calls",
              "meetings",
              "emails",
              "products",
              "line_items",
              "quotes",
              "leads"
            ]
          },
          "query": {
            "type": "string",
            "description": "Text matched against the default searchable properties (e.g. name, email, domain)"
          },
          "filter_groups": {
            "type": "array",
            "description": "e.g. [{\"filters\": [{\"propertyName\": \"lifecyclestage\", \"operator\": \"EQ\", \"value\": \"lead\"}]}]; operators EQ, NEQ, LT, LTE, GT, GTE, BETWEEN, IN, NOT_IN, HAS_PROPERTY, NOT_HAS_PROPERTY, CONTAINS_TOKEN, NOT_CONTAINS_TOKEN",
            "maxItems": 5,
            "items": {
              "type": "object"
            }
          },
          "sorts": {
            "type": "array",
            "description": "One sort, e.g. [{\"propertyName\": \"createdate\", \"direction\": \"DESCENDING\"}]",
            "maxItems": 1,
            "items": {
              "type": "object"
            }
          },
          "properties": {
            "type": "array",
            "description": "Properties to return",
            "maxItems": 200,
            "items": {
              "type": "string"
            }
          },
          "cursor": {
            "type": "string",
            "description": "next_cursor from the previous call, to get the next page"
          },
          "limit": {
            "type": "integer",
            "description": "Maximum items per page (sent as `limit`)",
            "minimum": 1,
            "maximum": 200,
            "default": 20
          }
        },
        "required": [
          "object_type"
        ]
      }
    },
    {
      "name": "create_object",
      "description": "Create a record with property values, optionally associated with other records",
      "parameters": {
        "type": "object",
        "properties": {
          "object_type": {
