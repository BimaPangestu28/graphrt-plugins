    {
      "kind": "hubspot.create_note",
      "title": "Add note",
      "description": "Add a note to the timeline of contacts, companies, deals or tickets",
      "category": "integration",
      "config_schema": {
        "type": "object",
        "properties": {
          "body": {
            "type": "string",
            "minLength": 1,
            "description": "Note text (HTML allowed, up to 65,536 characters)"
          },
