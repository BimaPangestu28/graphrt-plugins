            "type": "string",
            "description": "When the note happened, ISO 8601 (default: now); sets its place on the timeline"
          },
          "owner_id": {
            "type": "string",
            "description": "HubSpot owner id (from list_owners) to attribute the note to"
          },
          "contact_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 100,
            "description": "Contact record ids to attach the note to"
          },
          "company_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 100,
            "description": "Company record ids to attach the note to"
          },
          "deal_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 100,
            "description": "Deal record ids to attach the note to"
          },
          "ticket_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 100,
            "description": "Ticket record ids to attach the note to"
          },
          "access_token": {
            "type": "string",
            "description": "Overrides the plugin's default token for this node (use a secret; needs --trust-plugin)"
          }
        },
        "required": [
          "body"
        ]
      },
      "outputs": [
