    },
    {
      "kind": "linear.get_project",
      "title": "Get project",
      "description": "One project with its first 100 issues",
      "category": "integration",
      "config_schema": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string",
            "description": "Project id"
          },
          "access_token": {
            "type": "string",
            "description": "Overrides the plugin's default token for this node (use a secret; needs --trust-plugin)"
          }
