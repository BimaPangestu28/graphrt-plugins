          "issue_id"
        ]
      },
      "outputs": [
        {
          "name": "data",
          "type": "any",
          "description": "API result"
        },
        {
          "name": "next_cursor",
          "type": "string",
          "description": "Cursor for the next page, empty when there is none"
        }
      ]
    },
    {
      "kind": "linear.create_comment",
      "title": "Comment on issue",
      "description": "Add a Markdown comment to an issue (as an agent tool only when LINEAR_TOOL_ALLOW_WRITE=1)",
      "category": "integration",
      "config_schema": {
        "type": "object",
        "properties": {
          "issue_id": {
            "type": "string",
            "description": "Issue id (UUID; use get_issue to resolve an identifier)"
          },
          "body": {
            "type": "string",
            "description": "Markdown",
            "minLength": 1
          },
          "access_token": {
            "type": "string",
            "description": "Overrides the plugin's default token for this node (use a secret; needs --trust-plugin)"
          }
        },
        "required": [
          "issue_id",
          "body"
        ]
      },
      "outputs": [
        {
          "name": "data",
          "type": "any",
          "description": "API result"
        },
        {
          "name": "next_cursor",
          "type": "string",
          "description": "Cursor for the next page, empty when there is none"
        }
      ]
    },
    {
