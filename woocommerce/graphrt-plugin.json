{
  "name": "woocommerce",
  "version": "0.1.0",
  "description": "WooCommerce REST API v3: products, variations, orders, customers, refunds; product and order-status writes opt-in, prices, stock and refunds node only",
  "license": "Apache-2.0",
  "runtime": "process",
  "command": "node",
  "args": [
    "plugin.mjs"
  ],
  "permissions": {
    "network": true,
    "secrets": true,
    "env": [
      "WOOCOMMERCE_CONSUMER_SECRET",
      "WOOCOMMERCE_CONSUMER_KEY",
      "WOOCOMMERCE_SITE_URL",
      "WOOCOMMERCE_TOOL_API_EXTRA_PATHS",
      "WOOCOMMERCE_TOOL_ALLOW_PRODUCTS",
      "WOOCOMMERCE_TOOL_ALLOW_ORDER_STATUS"
    ]
  },
  "limits": {
    "timeout_ms": 120000,
    "max_concurrency": 8
  },
  "nodes": [
    {
      "kind": "woocommerce.list_products",
      "title": "List products",
      "description": "List products (newest first by default)",
      "category": "integration",
      "config_schema": {
        "type": "object",
        "properties": {
          "search": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "any",
              "draft",
              "pending",
              "private",
              "publish"
            ]
          },
          "category": {
            "type": "string",
            "description": "Category id"
          },
          "stock_status": {
            "type": "string",
            "enum": [
              "instock",
              "outofstock",
              "onbackorder"
            ]
          },
          "orderby": {
            "type": "string",
            "enum": [
              "date",
              "id",
              "title",
              "slug",
              "modified",
              "include"
            ]
          },
          "order": {
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ]
          },
          "cursor": {
            "type": "string",
            "description": "next_cursor from the previous call, to get the next page"
          },
          "limit": {
            "type": "integer",
            "description": "Maximum items per page (sent as `per_page`)",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          },
          "access_token": {
            "type": "string",
            "description": "Overrides the plugin's default token for this node (use a secret; needs --trust-plugin)"
          }
        },
        "required": []
      },
      "outputs": [
        {
          "name": "data",
          "type": "any",
          "description": "API result"
        },
        {
          "name": "next_cursor",
          "type": "string",
          "description": "Cursor for the next page, empty when there is none"
        }
      ]
    },
    {
      "kind": "woocommerce.get_product",
      "title": "Get product",
      "description": "Retrieve a product",
      "category": "integration",
      "config_schema": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "integer",
            "description": "Product id",
            "minimum": 1
          },
          "access_token": {
            "type": "string",
            "description": "Overrides the plugin's default token for this node (use a secret; needs --trust-plugin)"
          }
        },
        "required": [
          "product_id"
        ]
      },
      "outputs": [
        {
          "name": "data",
          "type": "any",
          "description": "API result"
        },
        {
          "name": "next_cursor",
          "type": "string",
          "description": "Cursor for the next page, empty when there is none"
        }
      ]
    },
    {
      "kind": "woocommerce.list_product_variations",
      "title": "List product variations",
      "description": "List the variations of a variable product",
      "category": "integration",
      "config_schema": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "integer",
            "description": "Product id",
            "minimum": 1
          },
          "cursor": {
            "type": "string",
            "description": "next_cursor from the previous call, to get the next page"
          },
          "limit": {
            "type": "integer",
            "description": "Maximum items per page (sent as `per_page`)",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          },
          "access_token": {
            "type": "string",
            "description": "Overrides the plugin's default token for this node (use a secret; needs --trust-plugin)"
          }
        },
        "required": [
          "product_id"
        ]
      },
      "outputs": [
        {
          "name": "data",
          "type": "any",
          "description": "API result"
        },
        {
          "name": "next_cursor",
          "type": "string",
          "description": "Cursor for the next page, empty when there is none"
        }
      ]
    },
    {
      "kind": "woocommerce.update_product",
      "title": "Update product",
      "description": "Update a product's name, descriptions, status, SKU, categories or tags; prices and stock too, but only from workflow nodes (as an agent tool only when WOOCOMMERCE_TOOL_ALLOW_PRODUCTS=1)",
      "category": "integration",
      "config_schema": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "integer",
            "description": "Product id",
            "minimum": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "short_description": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "pending",
              "private",
              "publish"
            ]
          },
          "sku": {
            "type": "string"
          },
          "categories": {
            "type": "array",
            "description": "[{id}]",
            "items": {
              "type": "object"
            }
          },
          "tags": {
            "type": "array",
            "description": "[{id}] or [{name}]",
            "items": {
              "type": "object"
            }
          },
          "regular_price": {
            "type": "string",
            "description": "Node only. Decimal string, e.g. \"19.99\""
          },
          "sale_price": {
            "type": "string",
            "description": "Node only"
          },
          "manage_stock": {
            "type": "boolean",
            "description": "Node only"
          },
          "stock_quantity": {
            "type": "integer",
            "description": "Node only"
          },
          "stock_status": {
            "type": "string",
            "description": "Node only",
            "enum": [
              "instock",
              "outofstock",
              "onbackorder"
            ]
          },
          "access_token": {
            "type": "string",
            "description": "Overrides the plugin's default token for this node (use a secret; needs --trust-plugin)"
          }
        },
        "required": [
          "product_id"
        ]
      },
      "outputs": [
        {
          "name": "data",
          "type": "any",
          "description": "API result"
        },
        {
          "name": "next_cursor",
          "type": "string",
          "description": "Cursor for the next page, empty when there is none"
        }
      ]
    },
    {
      "kind": "woocommerce.list_orders",
      "title": "List orders",
      "description": "List orders (newest first by default)",
      "category": "integration",
      "config_schema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "array",
            "description": "Order statuses (comma-separated)",
            "items": {
              "type": "string",
              "enum": [
                "any",
                "pending",
                "processing",
                "on-hold",
                "completed",
                "cancelled",
                "refunded",
                "failed",
                "draft"
              ]
            }
          },
          "customer": {
            "type": "integer",
            "description": "Customer id"
          },
          "search": {
            "type": "string"
          },
          "after": {
            "type": "string",
            "description": "Created after (ISO 8601)"
          },
          "before": {
            "type": "string",
            "description": "Created before (ISO 8601)"
          },
          "orderby": {
            "type": "string",
            "enum": [
              "date",
              "id",
              "title",
              "slug",
              "modified",
              "include"
            ]
          },
          "order": {
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ]
          },
          "cursor": {
            "type": "string",
            "description": "next_cursor from the previous call, to get the next page"
          },
          "limit": {
            "type": "integer",
            "description": "Maximum items per page (sent as `per_page`)",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          },
          "access_token": {
            "type": "string",
            "description": "Overrides the plugin's default token for this node (use a secret; needs --trust-plugin)"
          }
        },
        "required": []
      },
      "outputs": [
        {
          "name": "data",
          "type": "any",
          "description": "API result"
        },
        {
          "name": "next_cursor",
          "type": "string",
          "description": "Cursor for the next page, empty when there is none"
        }
      ]
    },
    {
      "kind": "woocommerce.get_order",
      "title": "Get order",
      "description": "Retrieve an order",
      "category": "integration",
      "config_schema": {
        "type": "object",
        "properties": {
          "order_id": {
            "type": "integer",
            "description": "Order id",
            "minimum": 1
          },
          "access_token": {
            "type": "string",
            "description": "Overrides the plugin's default token for this node (use a secret; needs --trust-plugin)"
          }
        },
        "required": [
          "order_id"
        ]
      },
      "outputs": [
        {
          "name": "data",
          "type": "any",
          "description": "API result"
        },
        {
          "name": "next_cursor",
          "type": "string",
          "description": "Cursor for the next page, empty when there is none"
        }
      ]
    },
    {
      "kind": "woocommerce.update_order_status",
      "title": "Update order status",
      "description": "Change an order's status (WooCommerce may email the customer, e.g. on completed). Agent tools may only set on-hold (as an agent tool only when WOOCOMMERCE_TOOL_ALLOW_ORDER_STATUS=1)",
      "category": "integration",
      "config_schema": {
        "type": "object",
        "properties": {
          "order_id": {
            "type": "integer",
            "description": "Order id",
            "minimum": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "processing",
              "on-hold",
              "completed",
              "cancelled",
              "refunded",
              "failed",
              "draft"
            ]
          },
          "access_token": {
            "type": "string",
            "description": "Overrides the plugin's default token for this node (use a secret; needs --trust-plugin)"
          }
        },
        "required": [
          "order_id",
          "status"
        ]
      },
      "outputs": [
        {
          "name": "data",
          "type": "any",
          "description": "API result"
        },
        {
          "name": "next_cursor",
          "type": "string",
          "description": "Cursor for the next page, empty when there is none"
        }
      ]
    },
    {
      "kind": "woocommerce.list_order_refunds",
      "title": "List order refunds",
      "description": "List the refunds of an order",
      "category": "integration",
      "config_schema": {
        "type": "object",
        "properties": {
          "order_id": {
            "type": "integer",
            "description": "Order id",
            "minimum": 1
          },
          "cursor": {
            "type": "string",
            "description": "next_cursor from the previous call, to get the next page"
          },
          "limit": {
            "type": "integer",
            "description": "Maximum items per page (sent as `per_page`)",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          },
          "access_token": {
            "type": "string",
            "description": "Overrides the plugin's default token for this node (use a secret; needs --trust-plugin)"
          }
        },
        "required": [
          "order_id"
        ]
      },
      "outputs": [
        {
          "name": "data",
          "type": "any",
          "description": "API result"
        },
        {
          "name": "next_cursor",
          "type": "string",
          "description": "Cursor for the next page, empty when there is none"
        }
      ]
    },
    {
      "kind": "woocommerce.create_refund",
      "title": "Create refund",
      "description": "Refund an order (by default through the payment gateway: money goes back to the customer)",
      "category": "integration",
      "config_schema": {
        "type": "object",
        "properties": {
          "order_id": {
            "type": "integer",
            "description": "Order id",
            "minimum": 1
          },
          "amount": {
            "type": "string",
            "description": "Decimal string, e.g. \"10.00\"",
            "minLength": 1
          },
          "reason": {
            "type": "string"
          },
          "line_items": {
            "type": "array",
            "description": "[{id, quantity, refund_total, refund_tax?}]",
            "items": {
              "type": "object"
            }
          },
          "api_refund": {
            "type": "boolean",
            "description": "Refund through the payment gateway (false only records it)",
            "default": true
          },
          "api_restock": {
            "type": "boolean",
            "description": "Restock refunded items"
          },
          "access_token": {
            "type": "string",
            "description": "Overrides the plugin's default token for this node (use a secret; needs --trust-plugin)"
          }
        },
        "required": [
          "order_id",
          "amount"
        ]
      },
      "outputs": [
        {
          "name": "data",
          "type": "any",
          "description": "API result"
        },
        {
          "name": "next_cursor",
          "type": "string",
          "description": "Cursor for the next page, empty when there is none"
        }
      ]
    },
    {
      "kind": "woocommerce.list_customers",
      "title": "List customers",
      "description": "List customers",
      "category": "integration",
      "config_schema": {
        "type": "object",
        "properties": {
          "search": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "default": "all"
          },
          "orderby": {
            "type": "string",
            "enum": [
              "date",
              "id",
              "title",
              "slug",
              "modified",
              "include"
            ]
          },
          "order": {
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ]
          },
