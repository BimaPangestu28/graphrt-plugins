          }
        },
        "required": []
      },
      "outputs": [
        {
          "name": "data",
          "type": "any",
          "description": "API result"
        },
        {
          "name": "next_cursor",
          "type": "string",
          "description": "Cursor for the next page, empty when there is none"
        }
      ]
    },
    {
      "kind": "woocommerce.get_customer",
      "title": "Get customer",
      "description": "Retrieve a customer",
      "category": "integration",
      "config_schema": {
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "integer",
            "description": "Customer id",
            "minimum": 1
          },
          "access_token": {
            "type": "string",
            "description": "Overrides the plugin's default token for this node (use a secret; needs --trust-plugin)"
          }
        },
        "required": [
          "customer_id"
        ]
      },
      "outputs": [
        {
          "name": "data",
          "type": "any",
          "description": "API result"
        },
        {
          "name": "next_cursor",
          "type": "string",
          "description": "Cursor for the next page, empty when there is none"
        }
      ]
    },
    {
      "kind": "woocommerce.api_request",
      "title": "WooCommerce REST API request",
      "description": "Call any WooCommerce REST API endpoint that has no dedicated operation, e.g. path \"/reports/sales\". Only the API's own host is allowed.",
      "category": "integration",
      "config_schema": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string",
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE"
            ],
            "default": "GET"
          },
          "path": {
            "type": "string",
            "description": "Path relative to the API base, starting with \"/\", e.g. \"/reports/sales\""
          },
          "query": {
            "type": "object",
            "description": "Query parameters"
          },
          "body": {
            "type": "object",
            "description": "JSON body for POST/PUT/PATCH"
          },
          "access_token": {
            "type": "string",
            "description": "Overrides the plugin's default token for this node (use a secret; needs --trust-plugin)"
          }
        },
        "required": [
          "path"
        ]
      },
      "outputs": [
        {
          "name": "data",
          "type": "any",
          "description": "API result"
        },
        {
          "name": "next_cursor",
          "type": "string",
          "description": "Cursor for the next page, empty when there is none"
        }
      ]
    }
  ],
