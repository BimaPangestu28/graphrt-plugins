    {
      "kind": "todoist.delete_task",
      "title": "Delete task",
      "description": "Delete a task and its sub-tasks",
      "category": "integration",
      "config_schema": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "description": "Task id (from list_tasks)"
          },
          "access_token": {
            "type": "string",
            "description": "Overrides the plugin's default token for this node (use a secret; needs --trust-plugin)"
          }
        },
        "required": [
