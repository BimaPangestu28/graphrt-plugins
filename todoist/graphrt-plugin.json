{
  "name": "todoist",
  "version": "0.1.0",
  "description": "Todoist (API v1): projects, sections, tasks (filter, completed, create, quick add, update, move, complete, reopen), labels and comments; deletes are node only",
  "license": "Apache-2.0",
  "runtime": "process",
  "command": "node",
  "args": [
    "plugin.mjs"
  ],
  "permissions": {
    "network": true,
    "secrets": true,
    "env": [
      "TODOIST_API_TOKEN"
    ]
  },
  "limits": {
    "timeout_ms": 120000,
    "max_concurrency": 8
  },
  "nodes": [
    {
      "kind": "todoist.get_user",
      "title": "Current user",
      "description": "The account's name, email, time zone, inbox project and goals (token fields removed)",
      "category": "integration",
      "config_schema": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "description": "Overrides the plugin's default token for this node (use a secret; needs --trust-plugin)"
          }
        },
        "required": []
      },
      "outputs": [
        {
          "name": "data",
          "type": "any",
          "description": "API result"
        },
        {
          "name": "next_cursor",
          "type": "string",
          "description": "Cursor for the next page, empty when there is none"
        }
      ]
    },
    {
      "kind": "todoist.list_projects",
      "title": "List projects",
      "description": "Active projects",
      "category": "integration",
      "config_schema": {
        "type": "object",
        "properties": {
          "folder_id": {
            "type": "integer",
            "description": "Only projects in this workspace folder"
          },
          "cursor": {
            "type": "string",
            "description": "next_cursor from the previous call, to get the next page"
          },
          "limit": {
            "type": "integer",
            "description": "Maximum items per page (sent as `limit`)",
            "minimum": 1,
            "maximum": 200,
            "default": 50
          },
          "access_token": {
            "type": "string",
            "description": "Overrides the plugin's default token for this node (use a secret; needs --trust-plugin)"
          }
        },
        "required": []
      },
      "outputs": [
        {
          "name": "data",
          "type": "any",
          "description": "API result"
        },
        {
          "name": "next_cursor",
          "type": "string",
          "description": "Cursor for the next page, empty when there is none"
        }
      ]
    },
    {
      "kind": "todoist.get_project",
      "title": "Get project",
      "description": "One project",
      "category": "integration",
      "config_schema": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string",
            "description": "Project id (from list_projects)"
          },
          "access_token": {
            "type": "string",
            "description": "Overrides the plugin's default token for this node (use a secret; needs --trust-plugin)"
          }
        },
        "required": [
          "project_id"
        ]
      },
      "outputs": [
        {
          "name": "data",
          "type": "any",
          "description": "API result"
        },
        {
          "name": "next_cursor",
          "type": "string",
          "description": "Cursor for the next page, empty when there is none"
        }
      ]
    },
    {
      "kind": "todoist.create_project",
      "title": "Create project",
      "description": "Create a personal project (or a sub-project with parent_id)",
      "category": "integration",
      "config_schema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "parent_id": {
            "type": "string",
            "description": "Parent project id"
          },
          "description": {
            "type": "string"
          },
          "color": {
            "type": "string",
            "description": "Color name, e.g. berry_red, blue, grey"
          },
          "is_favorite": {
            "type": "boolean"
          },
          "project_view_style": {
            "type": "string",
            "description": "Project layout",
            "enum": [
              "list",
              "board",
              "calendar"
            ]
          },
          "access_token": {
            "type": "string",
            "description": "Overrides the plugin's default token for this node (use a secret; needs --trust-plugin)"
          }
        },
        "required": [
          "name"
        ]
      },
      "outputs": [
        {
          "name": "data",
          "type": "any",
          "description": "API result"
        },
        {
          "name": "next_cursor",
          "type": "string",
          "description": "Cursor for the next page, empty when there is none"
        }
      ]
    },
    {
      "kind": "todoist.update_project",
      "title": "Update project",
      "description": "Rename a project or change its description, color, favorite flag or layout",
      "category": "integration",
      "config_schema": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string",
            "description": "Project id (from list_projects)"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "color": {
            "type": "string",
            "description": "Color name, e.g. berry_red, blue, grey"
          },
          "is_favorite": {
            "type": "boolean"
          },
          "project_view_style": {
            "type": "string",
            "description": "Project layout",
            "enum": [
              "list",
              "board",
              "calendar"
            ]
          },
          "access_token": {
            "type": "string",
            "description": "Overrides the plugin's default token for this node (use a secret; needs --trust-plugin)"
          }
        },
        "required": [
          "project_id"
        ]
      },
      "outputs": [
        {
          "name": "data",
          "type": "any",
          "description": "API result"
        },
        {
          "name": "next_cursor",
          "type": "string",
          "description": "Cursor for the next page, empty when there is none"
        }
      ]
    },
    {
      "kind": "todoist.list_sections",
      "title": "List sections",
      "description": "Sections of a project (or of all projects)",
      "category": "integration",
      "config_schema": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string"
          },
          "cursor": {
            "type": "string",
            "description": "next_cursor from the previous call, to get the next page"
          },
          "limit": {
            "type": "integer",
            "description": "Maximum items per page (sent as `limit`)",
            "minimum": 1,
            "maximum": 200,
            "default": 50
          },
          "access_token": {
            "type": "string",
            "description": "Overrides the plugin's default token for this node (use a secret; needs --trust-plugin)"
          }
        },
        "required": []
      },
      "outputs": [
        {
          "name": "data",
          "type": "any",
          "description": "API result"
        },
        {
          "name": "next_cursor",
          "type": "string",
          "description": "Cursor for the next page, empty when there is none"
        }
      ]
    },
    {
      "kind": "todoist.create_section",
      "title": "Create section",
      "description": "Add a section to a project",
      "category": "integration",
      "config_schema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "project_id": {
            "type": "string"
          },
          "order": {
            "type": "integer"
          },
          "access_token": {
            "type": "string",
            "description": "Overrides the plugin's default token for this node (use a secret; needs --trust-plugin)"
          }
        },
        "required": [
          "name",
          "project_id"
        ]
      },
      "outputs": [
        {
          "name": "data",
          "type": "any",
          "description": "API result"
        },
        {
          "name": "next_cursor",
          "type": "string",
          "description": "Cursor for the next page, empty when there is none"
        }
      ]
    },
    {
      "kind": "todoist.list_tasks",
      "title": "List tasks",
      "description": "Active tasks, optionally of one project, section, parent task or label",
      "category": "integration",
      "config_schema": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string"
          },
          "section_id": {
            "type": "string"
          },
          "parent_id": {
            "type": "string"
          },
          "label": {
            "type": "string",
            "description": "Label name"
          },
          "ids": {
            "type": "array",
            "description": "Only these task ids",
            "items": {
              "type": "string"
            }
          },
          "cursor": {
            "type": "string",
            "description": "next_cursor from the previous call, to get the next page"
          },
          "limit": {
            "type": "integer",
            "description": "Maximum items per page (sent as `limit`)",
            "minimum": 1,
            "maximum": 200,
            "default": 50
          },
          "access_token": {
            "type": "string",
            "description": "Overrides the plugin's default token for this node (use a secret; needs --trust-plugin)"
          }
        },
        "required": []
      },
      "outputs": [
        {
          "name": "data",
          "type": "any",
          "description": "API result"
        },
        {
          "name": "next_cursor",
          "type": "string",
          "description": "Cursor for the next page, empty when there is none"
        }
      ]
    },
    {
      "kind": "todoist.filter_tasks",
      "title": "Filter tasks",
      "description": "Active tasks matching a Todoist filter query, e.g. \"today | overdue\", \"#Work & p1\", \"assigned to: me\"",
      "category": "integration",
      "config_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Todoist filter query",
            "minLength": 1
          },
          "lang": {
            "type": "string",
            "description": "Language of the query, e.g. en"
          },
          "cursor": {
            "type": "string",
            "description": "next_cursor from the previous call, to get the next page"
          },
          "limit": {
            "type": "integer",
            "description": "Maximum items per page (sent as `limit`)",
            "minimum": 1,
            "maximum": 200,
            "default": 50
          },
          "access_token": {
            "type": "string",
            "description": "Overrides the plugin's default token for this node (use a secret; needs --trust-plugin)"
          }
        },
        "required": [
          "query"
        ]
      },
      "outputs": [
        {
          "name": "data",
          "type": "any",
          "description": "API result"
        },
        {
          "name": "next_cursor",
          "type": "string",
          "description": "Cursor for the next page, empty when there is none"
        }
      ]
    },
    {
      "kind": "todoist.list_completed_tasks",
      "title": "Completed tasks",
      "description": "Tasks completed in a time range (up to 3 months), optionally in one project or section",
      "category": "integration",
      "config_schema": {
        "type": "object",
        "properties": {
          "since": {
            "type": "string",
            "description": "From, e.g. 2026-11-01T00:00:00Z"
          },
          "until": {
            "type": "string",
            "description": "Until, e.g. 2026-11-19T23:59:59Z"
          },
          "project_id": {
            "type": "string"
          },
          "section_id": {
            "type": "string"
          },
          "filter_query": {
            "type": "string",
            "description": "Todoist filter query"
          },
          "cursor": {
            "type": "string",
            "description": "next_cursor from the previous call, to get the next page"
          },
          "limit": {
            "type": "integer",
            "description": "Maximum items per page (sent as `limit`)",
            "minimum": 1,
            "maximum": 200,
            "default": 50
          },
          "access_token": {
            "type": "string",
            "description": "Overrides the plugin's default token for this node (use a secret; needs --trust-plugin)"
          }
        },
        "required": [
          "since",
          "until"
        ]
      },
      "outputs": [
        {
          "name": "data",
          "type": "any",
          "description": "API result"
        },
        {
          "name": "next_cursor",
          "type": "string",
          "description": "Cursor for the next page, empty when there is none"
        }
      ]
    },
    {
      "kind": "todoist.get_task",
      "title": "Get task",
      "description": "One task",
      "category": "integration",
      "config_schema": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "description": "Task id (from list_tasks)"
          },
          "access_token": {
            "type": "string",
            "description": "Overrides the plugin's default token for this node (use a secret; needs --trust-plugin)"
          }
        },
        "required": [
          "task_id"
        ]
      },
      "outputs": [
        {
          "name": "data",
          "type": "any",
          "description": "API result"
        },
        {
          "name": "next_cursor",
          "type": "string",
          "description": "Cursor for the next page, empty when there is none"
        }
      ]
    },
    {
      "kind": "todoist.create_task",
      "title": "Create task",
      "description": "Create a task (in the Inbox unless a project is given)",
      "category": "integration",
      "config_schema": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "description": "Task name (markdown allowed)",
            "minLength": 1
          },
          "project_id": {
            "type": "string"
          },
          "section_id": {
            "type": "string"
          },
          "parent_id": {
            "type": "string",
            "description": "Parent task id, to create a sub-task"
          },
          "order": {
            "type": "integer"
          },
          "description": {
            "type": "string"
          },
          "labels": {
            "type": "array",
            "description": "Label names",
            "items": {
              "type": "string"
            }
          },
          "priority": {
            "type": "integer",
            "description": "1 normal to 4 urgent (4 is p1 in the apps)",
            "minimum": 1,
            "maximum": 4
          },
          "due_string": {
            "type": "string",
            "description": "Natural-language due date, e.g. \"tomorrow at 9\", \"every monday\""
          },
          "due_date": {
            "type": "string",
            "description": "Due date YYYY-MM-DD"
          },
          "due_datetime": {
            "type": "string",
            "description": "Due date and time, RFC 3339 in UTC"
          },
          "due_lang": {
            "type": "string",
            "description": "Language of due_string, e.g. en"
          },
          "assignee_id": {
            "type": "integer",
            "description": "User id of a collaborator of a shared project"
          },
          "duration": {
            "type": "integer",
            "description": "Duration amount (with duration_unit)",
            "minimum": 1
          },
          "duration_unit": {
            "type": "string",
            "enum": [
              "minute",
              "day"
            ]
          },
          "deadline_date": {
            "type": "string",
            "description": "Deadline YYYY-MM-DD"
          },
          "access_token": {
            "type": "string",
            "description": "Overrides the plugin's default token for this node (use a secret; needs --trust-plugin)"
          }
        },
        "required": [
          "content"
        ]
      },
      "outputs": [
        {
          "name": "data",
          "type": "any",
          "description": "API result"
        },
        {
          "name": "next_cursor",
          "type": "string",
          "description": "Cursor for the next page, empty when there is none"
        }
      ]
    },
    {
      "kind": "todoist.quick_add_task",
      "title": "Quick add",
      "description": "Create a task from one line in the apps' Quick Add syntax, e.g. \"Pay rent tomorrow #Home @bills p1\"",
      "category": "integration",
      "config_schema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "Quick Add text with dates, #project, @label, p1–p4",
            "minLength": 1
          },
          "note": {
            "type": "string",
            "description": "Comment added to the task"
          },
          "reminder": {
            "type": "string",
            "description": "Reminder date in natural language, e.g. \"tomorrow 9am\""
          },
          "auto_reminder": {
            "type": "boolean",
            "description": "Add the default reminder when the task has a due time"
          },
          "access_token": {
            "type": "string",
            "description": "Overrides the plugin's default token for this node (use a secret; needs --trust-plugin)"
          }
        },
        "required": [
          "text"
        ]
      },
      "outputs": [
        {
          "name": "data",
          "type": "any",
          "description": "API result"
        },
        {
          "name": "next_cursor",
          "type": "string",
          "description": "Cursor for the next page, empty when there is none"
        }
      ]
    },
    {
      "kind": "todoist.update_task",
      "title": "Update task",
      "description": "Change a task's content, description, labels, priority, due date, deadline, duration or assignee",
      "category": "integration",
      "config_schema": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "description": "Task id (from list_tasks)"
          },
          "content": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "labels": {
            "type": "array",
            "description": "Label names",
            "items": {
              "type": "string"
            }
          },
          "priority": {
            "type": "integer",
            "description": "1 normal to 4 urgent (4 is p1 in the apps)",
            "minimum": 1,
            "maximum": 4
          },
          "due_string": {
            "type": "string",
            "description": "Natural-language due date, e.g. \"tomorrow at 9\", \"every monday\""
          },
          "due_date": {
            "type": "string",
            "description": "Due date YYYY-MM-DD"
          },
          "due_datetime": {
            "type": "string",
            "description": "Due date and time, RFC 3339 in UTC"
          },
          "due_lang": {
            "type": "string",
            "description": "Language of due_string, e.g. en"
          },
          "assignee_id": {
            "type": "integer",
            "description": "User id of a collaborator of a shared project"
          },
          "duration": {
            "type": "integer",
            "description": "Duration amount (with duration_unit)",
            "minimum": 1
          },
          "duration_unit": {
            "type": "string",
            "enum": [
              "minute",
              "day"
            ]
          },
          "deadline_date": {
            "type": "string",
            "description": "Deadline YYYY-MM-DD"
          },
          "access_token": {
            "type": "string",
            "description": "Overrides the plugin's default token for this node (use a secret; needs --trust-plugin)"
          }
        },
        "required": [
          "task_id"
        ]
      },
      "outputs": [
        {
          "name": "data",
          "type": "any",
          "description": "API result"
        },
        {
          "name": "next_cursor",
          "type": "string",
          "description": "Cursor for the next page, empty when there is none"
        }
      ]
    },
    {
      "kind": "todoist.move_task",
      "title": "Move task",
      "description": "Move a task to another project, section or parent task (give exactly one)",
      "category": "integration",
      "config_schema": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "description": "Task id (from list_tasks)"
          },
          "project_id": {
            "type": "string"
          },
          "section_id": {
            "type": "string"
          },
          "parent_id": {
            "type": "string"
          },
          "access_token": {
            "type": "string",
            "description": "Overrides the plugin's default token for this node (use a secret; needs --trust-plugin)"
          }
        },
        "required": [
          "task_id"
        ]
      },
      "outputs": [
        {
          "name": "data",
          "type": "any",
          "description": "API result"
        },
        {
          "name": "next_cursor",
          "type": "string",
          "description": "Cursor for the next page, empty when there is none"
        }
      ]
    },
    {
      "kind": "todoist.close_task",
      "title": "Complete task",
      "description": "Complete a task (a recurring task moves to its next date)",
      "category": "integration",
      "config_schema": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "description": "Task id (from list_tasks)"
          },
          "access_token": {
            "type": "string",
            "description": "Overrides the plugin's default token for this node (use a secret; needs --trust-plugin)"
          }
        },
        "required": [
          "task_id"
        ]
      },
      "outputs": [
        {
          "name": "data",
          "type": "any",
          "description": "API result"
        },
        {
          "name": "next_cursor",
          "type": "string",
          "description": "Cursor for the next page, empty when there is none"
        }
      ]
    },
    {
      "kind": "todoist.reopen_task",
      "title": "Reopen task",
      "description": "Mark a completed task as not completed",
      "category": "integration",
      "config_schema": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "description": "Task id (from list_tasks)"
          },
          "access_token": {
            "type": "string",
